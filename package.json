{
  "name": "ocr-fee-analyzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "build:web:check": "node scripts/check-toolchain.mjs && node scripts/run-web-build-check.mjs",
    "build:all": "npm run build && npm run build:web",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "start": "NODE_ENV=production node dist/server.js",
    "test": "node scripts/check-toolchain.mjs && node scripts/run-test-baseline.mjs",
    "repo:clean-check": "node scripts/check-clean-checkout.mjs",
    "evaluation:five-statement-artifact:verify": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/verify-five-statement-live-artifact.ts",
    "parser:audit": "tsx scripts/parser-audit.ts",
    "corpus:test": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs ./node_modules/vitest/vitest.mjs run test/canonical",
    "corpus:audit": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/canonical-forensic-harness.ts",
    "corpus:secure": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/canonical-secure-corpus-runner.ts",
    "evaluation:integrity:dry-run": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/evaluation-run-integrity-dry-run.ts",
    "evaluation:integrity:run": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/evaluation-run-integrity-run.ts",
    "gold:validate": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/gold-contract-validate.ts",
    "gold:test": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs ./node_modules/vitest/vitest.mjs run test/gold-contract",
    "gold:audit": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/gold-contract-audit.ts",
    "gold:review": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/gold-contract-review.ts",
    "gold:secure": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/gold-contract-secure.ts",
    "fiserv:coverage": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/fiserv-coverage-audit.ts",
    "fiserv:coverage:check": "node scripts/check-toolchain.mjs && node scripts/run-fiserv-coverage-check.mjs",
    "ci:cleanliness": "node scripts/check-toolchain.mjs && node scripts/run-ci-cleanliness.mjs",
    "ci:cleanliness:generated": "node scripts/check-toolchain.mjs && node scripts/run-ci-cleanliness.mjs --generated-only",
    "ci:dependency-delta": "node scripts/check-dependency-advisory-delta.mjs",
    "ci:private-corpus-policy": "node scripts/check-private-corpus-policy.mjs",
    "bakeoff:pdf": "npm run build && node scripts/pdf-bakeoff.mjs",
    "bakeoff:azure": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/azure-layout-bakeoff.ts",
    "bakeoff:document-ir": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/document-ir-bakeoff.ts",
    "bakeoff:fiserv-document-ir": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/document-ir-bakeoff.ts",
    "validate:foundation": "node scripts/validate-merchant-foundation.mjs",
    "evaluate:fiserv-one": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/run-fiserv-pre-uat-evaluation.ts",
    "evaluate:fiserv-internal-live": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/run-fiserv-internal-live-evaluation.ts",
    "evaluate:internal-analyst-finding": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/evaluate-internal-analyst-finding-v1.ts",
    "evaluate:open-world-determinant": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/evaluate-open-world-determinant-v1.ts",
    "evaluate:decision-relevant-stage0": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/evaluate-decision-relevant-stage0-warrant-gate-v1.ts",
    "evaluate:per-authorization-commercial-runtime": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/evaluate-per-authorization-commercial-runtime-readiness-v1.ts",
    "evaluate:current-relationship-economics-profile": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/evaluate-current-relationship-economics-profile-v1.ts",
    "evaluate:claim-scoped-count-driven-cost-sensitivity": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/evaluate-claim-scoped-count-driven-cost-sensitivity-admission-v1.ts",
    "evaluate:claim-scoped-volume-driven-cost-sensitivity": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/evaluate-claim-scoped-volume-driven-cost-sensitivity-admission-v1.ts",
    "evaluate:claim-scoped-mixed-minimum-cost-sensitivity": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/evaluate-claim-scoped-mixed-minimum-cost-sensitivity-admission-v1.ts",
    "evaluate:claim-scoped-fixed-cost-sensitivity": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/evaluate-claim-scoped-fixed-cost-sensitivity-admission-v1.ts",
    "evaluate:shadow-ai-economic-resolution-planner": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/evaluate-shadow-ai-economic-resolution-planner-v1.ts",
    "requalify:provider-neutral-shadow-planner": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/qualify-shadow-ai-provider-neutral-v1.ts",
    "evaluate:provider-neutral-shadow-planner-phase3": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/evaluate-direct-openai-shadow-planner-phase3-v1.ts",
    "evaluate:fiserv-claim-scoped-activity-population-admission": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/evaluate-fiserv-claim-scoped-activity-population-admission-v1.ts",
    "evaluate:exact-control-fiserv-fee-occurrence-admission": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/evaluate-exact-control-claim-scoped-fiserv-fee-occurrence-admission-v1.ts",
    "evaluate:open-world-live-research": "node scripts/check-toolchain.mjs && node scripts/run-node-tool.mjs --import tsx scripts/evaluate-open-world-live-research-v1.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/openai": "^3.0.70",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "ai": "^6.0.116",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^5.5.6",
    "dotenv": "^17.3.1",
    "lucide-react": "^1.24.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "undici": "^7.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.13.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vite": "^5.4.21",
    "vitest": "2.1.9"
  }
}
